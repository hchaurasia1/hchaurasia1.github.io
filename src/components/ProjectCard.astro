---
interface Props {
  href: string;
  title: string;
  summary: string;
  company?: string;
  tags?: string[];
}
const { href, title, summary, company, tags = [] } = Astro.props;
---

<a href={href} class="card project-card">
  {company && <span class="pc-company">{company}</span>}
  <h3 class="pc-title">{title}</h3>
  <p class="pc-summary">{summary}</p>
  <ul class="pc-tags">
    {tags.slice(0, 4).map((t) => <li class="tag">{t}</li>)}
  </ul>
</a>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    padding: 1.25rem 1.5rem;
    color: var(--text);
    height: 100%;
  }
  .project-card:hover {
    color: var(--text);
    border-color: var(--accent);
  }
  .pc-company {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-dim);
    margin-bottom: 0.4rem;
  }
  .pc-title { margin: 0 0 0.5rem; }
  .pc-summary { flex: 1; margin-bottom: 1rem; font-size: 0.95rem; }
  .pc-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
