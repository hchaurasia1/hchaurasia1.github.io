---
// Atmospheric anime-inspired night sky. Pure CSS/SVG, no heavy assets.
// Swap this component's internals later for a bolder image if desired.
---

<div class="bg" aria-hidden="true">
  <div class="bg-sky"></div>
  <div class="bg-glow bg-glow-1"></div>
  <div class="bg-glow bg-glow-2"></div>
  <div class="bg-stars"></div>
  <div class="bg-stars bg-stars-2"></div>
  <div class="bg-grid"></div>
  <div class="bg-horizon"></div>
</div>

<style>
  .bg {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  /* deep vertical sky gradient (night → distant dawn) */
  .bg-sky {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(130% 90% at 50% 110%, rgba(124, 108, 240, 0.18) 0%, transparent 55%),
      linear-gradient(180deg, #05060f 0%, #070a16 40%, #0a0e20 75%, #0c1026 100%);
  }

  /* soft bloom orbs */
  .bg-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.55;
    animation: drift 26s ease-in-out infinite alternate;
  }
  .bg-glow-1 {
    width: 46vw;
    height: 46vw;
    left: -8vw;
    top: -6vw;
    background: radial-gradient(circle, rgba(139, 111, 240, 0.55), transparent 70%);
  }
  .bg-glow-2 {
    width: 40vw;
    height: 40vw;
    right: -6vw;
    top: 20vh;
    background: radial-gradient(circle, rgba(96, 165, 250, 0.33), transparent 70%);
    animation-delay: -8s;
    animation-duration: 32s;
  }

  /* starfields: tiny box-shadow dots, two layers twinkle at different rates */
  .bg-stars,
  .bg-stars-2 {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(1px 1px at 20% 30%, #ffffff 50%, transparent),
      radial-gradient(1px 1px at 75% 15%, #d9ddff 50%, transparent),
      radial-gradient(1px 1px at 45% 65%, #ffffff 50%, transparent),
      radial-gradient(1.5px 1.5px at 85% 55%, #c4b5fd 50%, transparent),
      radial-gradient(1px 1px at 15% 80%, #ffffff 50%, transparent),
      radial-gradient(1px 1px at 60% 40%, #e7ebf7 50%, transparent),
      radial-gradient(1.5px 1.5px at 30% 10%, #ffffff 50%, transparent),
      radial-gradient(1px 1px at 90% 85%, #d9ddff 50%, transparent);
    background-repeat: repeat;
    background-size: 420px 420px;
    opacity: 0.7;
    animation: twinkle 5s ease-in-out infinite;
  }
  .bg-stars-2 {
    background-size: 300px 300px;
    opacity: 0.4;
    animation-duration: 7s;
    animation-delay: -2s;
  }

  /* faint perspective grid near the horizon — subtle "techy" depth */
  .bg-grid {
    position: absolute;
    inset: 55% -20% -20% -20%;
    background-image:
      linear-gradient(to right, rgba(139, 111, 240, 0.12) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(139, 111, 240, 0.12) 1px, transparent 1px);
    background-size: 44px 44px;
    transform: perspective(380px) rotateX(62deg);
    transform-origin: top center;
    mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.6), transparent 75%);
    -webkit-mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.6), transparent 75%);
  }

  /* glow sitting on the horizon line */
  .bg-horizon {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 120vw;
    height: 30vh;
    transform: translateX(-50%);
    background: radial-gradient(60% 100% at 50% 100%, rgba(139, 111, 240, 0.22), transparent 70%);
  }

  @keyframes drift {
    from { transform: translate3d(0, 0, 0) scale(1); }
    to   { transform: translate3d(4vw, 3vh, 0) scale(1.08); }
  }
  @keyframes twinkle {
    0%, 100% { opacity: 0.35; }
    50%      { opacity: 0.8; }
  }

  @media (prefers-reduced-motion: reduce) {
    .bg-glow, .bg-stars, .bg-stars-2 { animation: none; }
  }
</style>
