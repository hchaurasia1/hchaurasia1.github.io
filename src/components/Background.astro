---

<div class="bg" aria-hidden="true">
  <div class="bg-sky"></div>
  <div class="bg-stars"></div>
</div>

<style>
  .bg {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .bg-sky {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, #05060f 0%, #070a14 50%, #0a0e1a 100%);
  }

  .bg-stars {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(1px 1px at 20% 30%, rgba(255, 255, 255, 0.5) 50%, transparent),
      radial-gradient(1px 1px at 75% 15%, rgba(217, 221, 255, 0.4) 50%, transparent),
      radial-gradient(1px 1px at 45% 65%, rgba(255, 255, 255, 0.35) 50%, transparent),
      radial-gradient(1px 1px at 85% 55%, rgba(196, 181, 253, 0.3) 50%, transparent),
      radial-gradient(1px 1px at 15% 80%, rgba(255, 255, 255, 0.4) 50%, transparent),
      radial-gradient(1px 1px at 60% 40%, rgba(231, 235, 247, 0.35) 50%, transparent);
    background-repeat: repeat;
    background-size: 420px 420px;
    opacity: 0.6;
  }
</style>
