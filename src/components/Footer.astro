---
import { SITE } from "../data/site";
const year = 2026;
---

<footer class="footer">
  <div class="container footer-inner">
    <p class="dim">© {year} Himanshu Chaurasia · Built with Astro</p>
    <ul class="social">
      <li><a href={SITE.github} target="_blank" rel="noopener">GitHub</a></li>
      <li><a href={SITE.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
      <li><a href={`mailto:${SITE.email}`}>Email</a></li>
    </ul>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    margin-top: 2rem;
    background: rgba(7, 10, 20, 0.4);
  }
  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.75rem;
    flex-wrap: wrap;
  }
  .footer-inner p { margin: 0; font-size: 0.9rem; }
  .social {
    display: flex;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.9rem;
  }
  .social a { color: var(--text-muted); }
  .social a:hover { color: var(--accent); }
</style>
