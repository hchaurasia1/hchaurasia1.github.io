---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((p) => ({
    params: { slug: p.slug },
    props: { post: p },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { data } = post;
const { Content } = await post.render();
---

<BaseLayout title={`${data.title} · Himanshu Chaurasia`} description={data.description}>
  <article class="container post">
    <a href="/blog" class="back">&larr; All posts</a>
    <header>
      <time datetime={data.pubDate.toISOString()}>
        {data.pubDate.toLocaleDateString("en-GB", {
          day: "numeric",
          month: "long",
          year: "numeric",
        })}
      </time>
      <h1>{data.title}</h1>
      {data.tags.length > 0 && (
        <ul class="tags">
          {data.tags.map((t) => <li class="tag">{t}</li>)}
        </ul>
      )}
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .post { padding-block: clamp(2rem, 5vw, 3.5rem) 4rem; max-width: 720px; }
  .back {
    display: inline-block;
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
    color: var(--text-muted);
  }
  .back:hover { color: var(--accent); }
  header { margin-bottom: 2.5rem; }
  header time {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-dim);
  }
  header h1 { margin-top: 0.5rem; }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
  }

  .prose { font-size: 1.05rem; }
  .prose :global(h2) {
    margin-top: 2.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    color: var(--text);
  }
  .prose :global(h3) { margin-top: 1.75rem; color: var(--text); }
  .prose :global(p) { color: var(--text-muted); }
  .prose :global(strong) { color: var(--text); }
  .prose :global(ul) { color: var(--text-muted); padding-left: 1.25rem; }
  .prose :global(li) { margin-bottom: 0.4rem; }
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: var(--accent-soft);
    padding: 0.1em 0.4em;
    border-radius: 6px;
    color: var(--accent);
  }
  .prose :global(a) { text-decoration: underline; text-underline-offset: 3px; }
</style>
