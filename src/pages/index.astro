---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectList from "../components/ProjectList.astro";
---

<BaseLayout>
  <p class="opening">
    I'm <strong>Himanshu</strong>, a senior backend engineer with 6.5 years of
    experience building distributed systems for logistics and telecom domains.
  </p>
  <p class="soft">
    I'm currently an SDE-3 at Flexport in Bangalore, working on Returns and Prep.
    Before that I was at Airtel, where I built the broadband fault repair system
    used across India.
  </p>

  <h2>Projects</h2>
  <ProjectList />
</BaseLayout>

<style>
  .opening {
    font-size: 34px;
    line-height: 1.35;
    margin-bottom: 32px;
    font-variation-settings: "opsz" 48;
  }
  @media (max-width: 560px) {
    .opening { font-size: 26px; }
  }
</style>
