---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../data/site";
import { SKILL_GROUPS, EXPERIENCE, EDUCATION } from "../data/content";
---

<BaseLayout title="About, Himanshu Chaurasia">
  <h1>About</h1>
  <p>
    I'm a senior backend engineer with 6.5 years of experience, currently an SDE-3 at
    Flexport working on Returns and Prep. Before that I built fault repair and field
    dispatch systems at Airtel. I like hard state-management problems and backend
    systems that keep working when the things around them don't.
  </p>
  <p>
    You can <a href={SITE.resume} target="_blank" rel="noopener">download my résumé</a>
    or email me at <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
  </p>

  <h2>Experience</h2>
  {EXPERIENCE.map((job) => (
    <section class="job">
      <h3><a href={job.url} target="_blank" rel="noopener">{job.company}</a></h3>
      <p class="soft meta">{job.role}, {job.period}, {job.location}</p>
      <ul>
        {job.points.map((p) => <li>{p}</li>)}
      </ul>
    </section>
  ))}

  <h2>Skills</h2>
  {SKILL_GROUPS.map((g) => (
    <p><strong>{g.title}:</strong> {g.items.join(", ")}.</p>
  ))}

  <h2>Education</h2>
  <p>
    {EDUCATION.degree}, {EDUCATION.school}, {EDUCATION.period}.
  </p>
</BaseLayout>

<style>
  .job { margin-bottom: 36px; }
  .job h3 { margin-bottom: 0; }
  .job h3 a { color: var(--ink); }
  .meta { font-size: 17px; margin-bottom: 10px; }
  .job ul { padding-left: 1.25em; margin: 0; }
  .job li { margin-bottom: 0.5em; }
</style>
