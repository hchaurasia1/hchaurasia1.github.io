---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((p) => ({
    params: { slug: p.slug },
    props: { project: p },
  }));
}

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await project.render();
---

<BaseLayout title={`${data.title} · Himanshu Chaurasia`} description={data.summary}>
  <article class="container case">
    <a href="/projects" class="back">← All projects</a>

    <header class="case-head">
      {data.company && (
        <p class="eyebrow">{data.company}{data.period ? ` · ${data.period}` : ""}</p>
      )}
      <h1>{data.title}</h1>
      <p class="case-summary">{data.summary}</p>

      {data.tags.length > 0 && (
        <ul class="case-tags">
          {data.tags.map((t) => <li class="tag">{t}</li>)}
        </ul>
      )}

      {data.links.length > 0 && (
        <div class="case-links">
          {data.links.map((l) => (
            <a href={l.href} target="_blank" rel="noopener" class="btn btn-ghost">{l.label}</a>
          ))}
        </div>
      )}
    </header>

    <div class="prose">
      <Content />
    </div>

    {data.stack.length > 0 && (
      <section class="stack">
        <h2 class="stack-title">Tech stack</h2>
        <ul class="stack-list">
          {data.stack.map((s) => <li class="tag">{s}</li>)}
        </ul>
      </section>
    )}
  </article>
</BaseLayout>

<style>
  .case { padding-block: clamp(2rem, 5vw, 3.5rem) 4rem; max-width: 820px; }
  .back {
    display: inline-block;
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
    color: var(--text-muted);
  }
  .back:hover { color: var(--accent); }
  .case-head { margin-bottom: 2.5rem; }
  .case-summary { font-size: 1.15rem; max-width: 60ch; margin-bottom: 1.25rem; }
  .case-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0 0 1.75rem;
    padding: 0;
  }
  .case-links { display: flex; gap: 0.75rem; flex-wrap: wrap; }

  .prose { font-size: 1.05rem; }
  .prose :global(h2) {
    margin-top: 2.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    color: var(--text);
  }
  .prose :global(h3) { margin-top: 1.75rem; color: var(--text); }
  .prose :global(p) { color: var(--text-muted); }
  .prose :global(strong) { color: var(--text); }
  .prose :global(ul) { color: var(--text-muted); padding-left: 1.25rem; }
  .prose :global(li) { margin-bottom: 0.4rem; }
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: var(--accent-soft);
    padding: 0.1em 0.4em;
    border-radius: 6px;
    color: var(--accent);
  }
  .prose :global(a) { text-decoration: underline; text-underline-offset: 3px; }

  .stack {
    margin-top: 2.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--border);
  }
  .stack-title { font-size: 1.1rem; color: var(--text); margin-bottom: 1rem; }
  .stack-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
