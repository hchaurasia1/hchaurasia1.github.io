---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((p) => ({
    params: { slug: p.slug },
    props: { project: p },
  }));
}

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await project.render();

const stack = new Intl.ListFormat("en", { type: "conjunction" }).format(data.stack);
---

<BaseLayout title={`${data.title}, Himanshu Chaurasia`} description={data.summary}>
  <article>
    <h1>{data.title}</h1>
    {data.company && <p class="soft where">{data.company}</p>}
    <p class="summary">{data.summary}</p>

    <div class="prose">
      <Content />
    </div>

    {data.stack.length > 0 && <p class="soft stack">Built with {stack}.</p>}

    {data.links.length > 0 && (
      <p class="links">
        {data.links.map((l) => (
          <a href={l.href} target="_blank" rel="noopener">{l.label}</a>
        ))}
      </p>
    )}
  </article>
</BaseLayout>

<style>
  .where { margin-top: -4px; font-size: 17px; }
  .summary { font-size: 22px; line-height: 1.55; margin: 28px 0 8px; }
  .stack {
    margin-top: 48px;
    padding-top: 16px;
    border-top: 1px solid var(--rule);
    font-size: 17px;
  }
  .links a { margin-right: 20px; }
</style>
